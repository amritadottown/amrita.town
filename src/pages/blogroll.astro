---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { FeedCache } from "@/types";
import faviconManifest from "@/favicon-manifest.json";
import { aggregatePosts, stripHtml, truncate } from "@/lib/feeds";

let cache: FeedCache = {};
try {
	cache = (await import("@/feed-cache.json")).default as unknown as FeedCache;
} catch {
	// not generated yet
}

const allPosts = aggregatePosts(cache);

const getFaviconSrc = (website: string) => {
	return faviconManifest[website] || "/favicon.png";
};
---

<BaseLayout title="Blogroll">
	<main class="blogroll-page">
		<h1>blogroll</h1>
		<p class="subtitle">
			recent posts from the <a href="/">amrita.town</a> webring
		</p>

		{
			allPosts.length > 0 ? (
				<div class="feed">
					{allPosts.map(({ post, member }) => (
						<article class="entry">
							<img
								src={getFaviconSrc(member.website)}
								onerror="this.onerror=null; this.src='/favicon.png';"
								alt=""
								class="avatar"
								width="24"
								height="24"
							/>
							<div class="body" style="line-height: 1.3;">
								<div class="meta">
									<span class="author">{member.name}</span>
									<time class="date" datetime={post.published}>
										{new Date(post.published).toLocaleDateString("en-US", {
											month: "short",
											day: "numeric",
											year: "numeric",
										})}
									</time>
								</div>
								<a href={post.link} class="title">
									{post.title}
								</a>
								{post.description && (
									<p class="description">
										{truncate(stripHtml(post.description), 320)}
									</p>
								)}
							</div>
						</article>
					))}
				</div>
			) : (
				<p class="empty">
					no posts yet — feeds are fetched at build time via{" "}
					<code>bun run scripts/fetch-feeds.ts</code>.
				</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.subtitle {
		margin-block-end: 1.5rem;
	}

	.feed {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.entry {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.5rem 0.75rem;
		padding: 0.75rem 0.5rem;
		border-radius: 0.2rem;
		transition: background 0.15s;
	}

	.entry:hover {
		background-color: var(--tertiary);
		outline: 1px solid var(--secondary);
	}

	.avatar {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 0%;
		image-rendering: pixelated;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
	}

	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		line-height: 1;
		margin-bottom: 0.2em;
	}

	.author {
		font-weight: 600;
		color: var(--accent);
	}

	.date {
		color: var(--secondary-light);
	}

	.title {
		color: var(--text);
		font-weight: 500;
		text-decoration: none;
		text-transform: none;
	}

	.title:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.description {
		color: var(--secondary-light);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-transform: none;
	}

	.empty {
		color: var(--secondary-light);
		font-style: italic;
	}
</style>
